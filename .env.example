# Variáveis de ambiente para o site JBA Jardinagem e Piscinas

# Google Analytics 4 (opcional - insira seu Measurement ID, ex: G-XXXXXXXXXX)
VITE_GA_ID=

# Google Search Console (opcional - insira o token da meta tag de verificação)
VITE_GSC_VERIFICATION=

# Desativação de HMR no ambiente de desenvolvimento em container
DISABLE_HMR=true
